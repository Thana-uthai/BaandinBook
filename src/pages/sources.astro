---
import Base from '@layouts/Base.astro';
import { allTopics, topicUrl, BOOK, SECTIONS, pdfPagesInRef } from '@lib/content';
const topics = allTopics().filter((t) => t.source_refs.length > 0 || t.master_refs.length > 0);
const chapters = [
  ['ปก ลิขสิทธิ์ จากสำนักพิมพ์ คำนำ ๓ ฉบับ สารบัญ เกริ่นนำ', '1–10', 'ปก–๑๗'],
  ['เรื่องเล่าในร่องรอยบ้านดิน', '11–~22', '๑๘–~๔๑'],
  ['บ้านดินคืออะไร', '~22–~26', '—'],
  ['หลักการออกแบบบ้านดินเบื้องต้น (ข้อ ๑–๔)', '~26–31', '~๔๖–๕๙'],
  ['การเลือกพื้นที่ในการก่อสร้าง', '32–35L', '๖๐–๖๖'],
  ['การทำฐานรากและระบบระบายน้ำ', '35R–38', '๖๗–๗๓'],
  ['เทคนิควิธี (ประเภทดิน, อิฐดินดิบ, ดินปั้น, ดินปั้นกับโครงไม้, เศษไม้/หิน, ดินอัด, กระสอบ, ฟางอัด)', '39–52', '๗๔–๑๐๑'],
  ['ประตู หน้าต่าง และช่องเปิดต่างๆ', '53–57', '๑๐๒–๑๑๑'],
  ['การทำหลังคา (รวมหลังคาดิน)', '58–62', '๑๑๒–๑๒๑'],
  ['การฉาบผิวและการตกแต่ง', '63–66', '๑๒๒–๑๒๙'],
  ['การทำพื้น', '67–69', '๑๓๐–๑๓๕'],
  ['การทำสีด้วยดิน', '70–72', '๑๓๖–๑๔๑'],
  ['ข้อแนะนำสำหรับผู้ที่จะเริ่มสร้างบ้านดิน (ฉบับย่อความ)', '73–76L', '๑๔๒–๑๔๘'],
  ['ภาคผนวก (บ้านดินมาจากไหน / ประวัติบ้านดินในประเทศไทย / Chobar / ดินฉาบผนัง / บ้านดิน vs บ้านปูน / นิยามวัสดุก่อสร้างที่ดี / ข้อผิดพลาดที่มักเกิดขึ้น / ตามรอยบ้านดิน / สร้างชีวิตด้วยบ้าน / บ้านดินกับสังคมเมือง / คำถามยอดฮิต)', '76R–108', '๑๔๙–๒๑๓'],
  ['ทำเนียบ “บ้านดินในประเทศไทย” (ไม่เผยแพร่ในระยะนี้ — D002)', '109–113L', '๒๑๔–๒๒๒'],
  ['ทำเนียบเครือข่ายบ้านดิน (ไม่เผยแพร่ — D009)', '113R–114L', '๒๒๓–๒๒๔'],
  ['ประมวลภาพบ้านดินและสิ่งก่อสร้างที่ทำจากดิน', '114R–121', '๒๒๔–๒๓๙'],
];
---
<Base title="ที่มาและเครดิต" description="ที่มาของเนื้อหา วิธีอ้างอิงหน้า และโครงบทของหนังสือ จากดินสู่บ้าน">
  <nav class="breadcrumb" aria-label="ตำแหน่งหน้า"><ol><li><a href="/">หน้าแรก</a></li><li aria-current="page">ที่มาและเครดิต</li></ol></nav>
  <h1>ที่มาและเครดิต</h1>
  <div class="read">
    <h2>หนังสือต้นฉบับ</h2>
    <dl class="topic-footer" style="border:0;margin:0;padding:0">
      <dt>ชื่อหนังสือ</dt><dd>{BOOK.title}</dd>
      <dt>ปีบริบทหลัก</dt><dd>พ.ศ. {BOOK.year_be} (PROJECT_DECISIONS D007) — {BOOK.era_text}</dd>
      <dt>ISBN</dt><dd>{BOOK.isbn} (ตรวจยืนยันใน Final Source QA)</dd>
      <dt>สิทธิ์เผยแพร่</dt><dd>เจ้าของโครงการอนุญาตให้นำเนื้อหาไปเผยแพร่ โดยคงเครดิต/การอ้างแหล่งที่มีอยู่ในต้นฉบับ (D001) — หน้าเครดิตผู้เขียนและสำนักพิมพ์ฉบับเต็ม (ชุด 01) จะนำขึ้นในเฟสถัดไปพร้อมหน้า /book</dd>
      <dt>ประเภทเนื้อหาบนเว็บ</dt><dd><span class="badge badge-editorial">EDITORIAL</span> สรุป/เรียบเรียง ทุกข้อความชี้แหล่งกลับหนังสือ · ไม่ใช่ข้อความต้นฉบับคำต่อคำ</dd>
    </dl>

    <h2>วิธีอ่านการอ้างอิงหน้า</h2>
    <p>การอ้างอิงใช้เลขหน้าไฟล์ PDF ของต้นฉบับสแกน เช่น <cite class="src">PDF 73R (๑๔๓)</cite> หมายถึงหน้า PDF ที่ 73 ด้านขวา (R) ตรงกับหนังสือหน้า ๑๔๓ · สูตร: หน้า PDF N ↔ หนังสือหน้า (2N−4) ซ้าย และ (2N−3) ขวา · <code>PDF 27–28</code> = ช่วงหน้า PDF (ระดับ PDF_RANGE) · <code>MASTER:ชุดNN/…</code> = หัวข้อในเอกสารถอดความที่ผ่าน QA (canonical MASTER)</p>
  </div>

  <h2>โครงบทของหนังสือ</h2>
  <p class="small muted">ช่วงหน้าโดยประมาณจากการถอดความ (C1_01) — ขอบเขตแน่นอนให้ยืนยันกับ MASTER</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th scope="col">บท</th><th scope="col">PDF</th><th scope="col">หนังสือหน้า (โดยประมาณ)</th></tr></thead>
      <tbody>{chapters.map(([c, p, b]) => <tr><td>{c}</td><td>{p}</td><td>{b}</td></tr>)}</tbody>
    </table>
  </div>

  <h2>แหล่งอ้างอิงของแต่ละหน้า (P0)</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th scope="col">หน้า</th><th scope="col">หมวด</th><th scope="col">แหล่งในหนังสือ</th><th scope="col">MASTER</th><th scope="col">สถานะ</th></tr></thead>
      <tbody>
        {topics.map((t) => (
          <tr>
            <td><a href={topicUrl(t)}>{t.topic_id} {t.title}</a></td>
            <td>{SECTIONS[t.section].title}</td>
            <td>{t.source_range}{pdfPagesInRef(t.source_range).length > 0 && <div class="small muted">หน้า PDF: {pdfPagesInRef(t.source_range).join(', ')}</div>}</td>
            <td class="small">{t.master_refs.join(' · ')}</td>
            <td class="small">{t.status} · master_qa {t.master_qa}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
