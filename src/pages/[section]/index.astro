---
import Base from '@layouts/Base.astro';
import TopicPage from '@components/TopicPage.astro';
import TopicCard from '@components/TopicCard.astro';
import { SECTIONS, SECTION_ORDER, sectionIndexTopic, topicsInSection, type Section } from '@lib/content';

export function getStaticPaths() {
  return SECTION_ORDER.map((section) => ({ params: { section } }));
}
const section = Astro.params.section as Section;
const meta = SECTIONS[section];
const index = sectionIndexTopic(section);
const topics = topicsInSection(section);
---
<Base title={index?.title ?? meta.title} description={meta.description} section={section}>
  {index ? (
    <>
      <TopicPage topic={index} />
      {topics.length > 0 && (
        <section aria-labelledby="in-section">
          <h2 id="in-section">หน้าในหมวด {meta.title}</h2>
          <ul class="cards">{topics.map((t) => <TopicCard topic={t} />)}</ul>
        </section>
      )}
    </>
  ) : (
    <>
      <nav class="breadcrumb" aria-label="ตำแหน่งหน้า"><ol><li><a href="/">หน้าแรก</a></li><li aria-current="page">{meta.title}</li></ol></nav>
      <h1>{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <section aria-labelledby="in-section">
        <h2 id="in-section">หน้าในหมวดนี้ ({topics.length})</h2>
        <ul class="cards">{topics.map((t) => <TopicCard topic={t} />)}</ul>
      </section>
    </>
  )}
</Base>
