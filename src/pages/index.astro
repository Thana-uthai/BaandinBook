---
import Base from '@layouts/Base.astro';
import TopicCard from '@components/TopicCard.astro';
import { allTopics, SECTIONS, SECTION_ORDER, sectionIndexTopic, topicsInSection, BOOK, DIAGRAMS } from '@lib/content';
const topics = allTopics();
const faq = topicsInSection('faq');
const safetyCount = topics.reduce((n, t) => n + t.safety_cautions.length, 0);
---
<Base title="จากดินสู่บ้าน" description="คลังความรู้บ้านดินจากหนังสือ จากดินสู่บ้าน สร้างบ้านด้วยดิน (พ.ศ. 2548) — เริ่มต้น เลือกเทคนิค ค้นตามปัญหา" eraBar={false}>
  <section class="hero">
    <div>
      <h1>สร้างบ้านด้วยดิน เริ่มจากความรู้ในหนังสือ</h1>
      <p class="lede">เรียบเรียงจากหนังสือ “{BOOK.title}” ให้สั้น อ่านง่ายบนมือถือ และทุกข้อความชี้กลับไปยังหน้าหนังสือต้นฉบับ</p>
      <p class="callout callout-era small"><strong>บริบทเวลา:</strong> {BOOK.era_text} — ราคา สถิติ ระยะเวลา และสภาพการณ์ที่กล่าวถึงเป็นของช่วงเวลานั้น</p>
    </div>
    <figure class="hero-art" aria-hidden="true">
      <!-- Decorative line sketch (editorial, not from the book): a small earthen house with a thatch roof, a tree and the sun. -->
      <svg viewBox="0 0 360 240" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="300" cy="52" r="20" fill="#f3d98a" stroke="#c48a1f" stroke-width="2.5"/>
        <path d="M300 20 V12 M300 92 V84 M268 52 H260 M340 52 H332 M277 29 L272 24 M328 75 L323 70 M323 29 L328 24 M272 75 L277 80" stroke="#c48a1f" stroke-width="2.5"/>
        <path d="M18 196 Q180 186 342 196" stroke="#51423a" stroke-width="3"/>
        <path d="M30 206 q6 -10 12 0 M60 210 q5 -8 10 0 M300 208 q6 -10 12 0 M330 206 q5 -8 10 0" stroke="#6b7b4b" stroke-width="2.5"/>
        <path d="M86 194 V118 H258 V194 Z" fill="#e4c9a4" stroke="#7d3a1e" stroke-width="3"/>
        <path d="M86 194 V118 Q100 116 112 118 V194" fill="#d9b98c" stroke="none"/>
        <path d="M98 150 q10 -2 18 0 M104 172 q8 -2 16 0 M236 140 q8 -2 14 0" stroke="#b7936a" stroke-width="2"/>
        <path d="M70 124 L172 58 L274 124" fill="#e0b25a" stroke="#7d3a1e" stroke-width="3.5"/>
        <path d="M92 110 L172 60 M110 98 L172 60 M130 86 L172 60 M254 112 L172 60 M236 100 L172 60 M216 88 L172 60" stroke="#b48633" stroke-width="2"/>
        <path d="M64 126 H280" stroke="#7d3a1e" stroke-width="3.5"/>
        <path d="M158 194 V146 H186 V194" fill="#a9502b" stroke="#7d3a1e" stroke-width="2.5"/>
        <path d="M110 140 H136 V164 H110 Z M208 140 H234 V164 H208 Z" fill="#fffaf2" stroke="#7d3a1e" stroke-width="2.5"/>
        <path d="M123 140 V164 M110 152 H136 M221 140 V164 M208 152 H234" stroke="#7d3a1e" stroke-width="2"/>
        <path d="M40 194 V140" stroke="#7d3a1e" stroke-width="4"/>
        <path d="M40 140 q-24 -4 -28 -30 q10 -18 30 -14 q26 -8 36 14 q6 24 -16 30 q-14 4 -22 0" fill="#9fae78" stroke="#6b7b4b" stroke-width="3"/>
        <path d="M40 140 L30 124 M40 140 L52 126" stroke="#7d3a1e" stroke-width="2.5"/>
      </svg>
      <figcaption>ภาพประกอบตกแต่ง (ไม่ใช่ภาพจากหนังสือ)</figcaption>
    </figure>
  </section>

  <section aria-labelledby="ways">
    <h2 id="ways">เริ่มต้นเร็ว 3 ทาง</h2>
    <ul class="three-ways">
      <li><a href="/start">
        <svg class="icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 27 C 10 20, 14 20, 16 14 S 22 6, 27 5"/><circle cx="5" cy="27" r="2.2" fill="currentColor"/><circle cx="16" cy="14" r="2.2" fill="currentColor"/><circle cx="27" cy="5" r="2.2" fill="currentColor"/></svg>
        <strong>เรียนตามลำดับ</strong>เส้นทางผู้เริ่มต้น ๘ ขั้น ตั้งแต่ตรวจบ้านเดิมจนถึงลงมือสร้างแบบเล็ก</a></li>
      <li><a href="/problems">
        <svg class="icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="6" width="24" height="20" rx="1.5"/><path d="M4 13 H28 M4 20 H28 M12 6 V13 M20 13 V20 M10 20 V26 M22 20 V26"/><path d="M16 4 l-2 6 3 4 -2 5" stroke-width="2.6"/></svg>
        <strong>ค้นตามปัญหา</strong>แตกร้าว ปลวก ฝน น้ำท่วม หลังคารั่ว เวลาและเงินบานปลาย</a></li>
      <li><a href="/techniques">
        <svg class="icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="19" width="11" height="7" rx="1"/><rect x="17" y="19" width="11" height="7" rx="1"/><rect x="10" y="11" width="11" height="7" rx="1"/><path d="M16 3 l6 4 -6 4 -6 -4 z"/></svg>
        <strong>เลือกเทคนิค</strong>อิฐดินดิบ ดินปั้น ดินอัด และตารางเปรียบเทียบตามที่หนังสือระบุ</a></li>
    </ul>
  </section>

  <section aria-labelledby="sections">
    <h2 id="sections">หมวดเนื้อหา</h2>
    <ul class="cards">
      {SECTION_ORDER.map((s) => {
        const idx = sectionIndexTopic(s);
        const n = topicsInSection(s).length + (idx ? 1 : 0);
        return (
          <li class="card">
            <h3><a href={`/${s}`}>{SECTIONS[s].title}</a></h3>
            <p class="small" style="margin:0">{SECTIONS[s].description}</p>
            <div class="meta">{n} หน้า</div>
          </li>
        );
      })}
    </ul>
  </section>

  <section aria-labelledby="faqh">
    <h2 id="faqh">คำถามยอดฮิต</h2>
    <ul class="cards">{faq.map((t) => <TopicCard topic={t} />)}</ul>
  </section>

  <section aria-labelledby="about-h" class="read">
    <h2 id="about-h">เนื้อหาในเว็บนี้มาจากไหน</h2>
    <p>ทุกหน้าเป็น <span class="badge badge-editorial">EDITORIAL</span> คือสรุป/เรียบเรียงเพื่อช่วยอ่าน ไม่ใช่ข้อความต้นฉบับคำต่อคำ ตัวเลข ขนาด อัตราส่วน และข้อควรระวังคงตามหนังสือ และผ่านการตรวจเทียบต้นฉบับแล้ว (P0: 26 หัวข้อ · ข้อควรระวัง {safetyCount} รายการ · ภาพวาดใหม่ {DIAGRAMS.length} ชุด)</p>
    <p><a href="/about">อ่านนโยบายเนื้อหาและความแตกต่างของ ORIGINAL / COMMUNITY / EDITORIAL</a> · <a href="/sources">ที่มาและเครดิต</a></p>
  </section>
</Base>
